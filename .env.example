# Copia este archivo a ".env" (nunca commiteado; ya está en .gitignore) y rellena los valores reales
# antes de ejecutar "docker compose up".

# --- PostgreSQL (contenedor "postgres") --------------------------------------------------------
# Deben coincidir con las credenciales embebidas en ConnectionStrings__Default más abajo.
POSTGRES_DB=devcontentengine
POSTGRES_USER=devcontentengine
POSTGRES_PASSWORD=

# --- Aplicación (Worker + Api) ------------------------------------------------------------------
# Cadena de conexión Npgsql hacia el contenedor "postgres" de este mismo docker-compose. El host
# "postgres" es el nombre del servicio en docker-compose.yml, resuelto por la red interna de Docker.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=devcontentengine;Username=devcontentengine;Password=

# Personal Access Token (fine-grained) de GitHub con acceso de lectura al repositorio a analizar.
GitHub__Token=

# Usuario de GitHub cuya actividad diaria analiza el pipeline. Requerida por el Worker: sin ella el
# job diario falla en cada ejecución (ver src/DevContentEngine.Worker/Jobs/GenerateDailyContentJob.cs).
GitHub__Username=

# API key de Anthropic usada para generar (y, si Llm__EnableReviewer=true, revisar) el contenido.
Llm__ApiKey=

# Modelo de Anthropic a usar. Opcional: si se omite, el código usa claude-sonnet-4-5-20250929.
Llm__Model=claude-sonnet-4-5-20250929

# Bot de Telegram usado para enviar cada borrador generado al usuario para revisión y aprobación
# manual. Crea el bot con @BotFather y obtén el chat id con @userinfobot o la API getUpdates.
Telegram__BotToken=
Telegram__ChatId=

# --- Panel de Hangfire (solo Worker, expuesto en /hangfire) -------------------------------------
# Credenciales HTTP Basic. Requeridas: el Worker no arranca sin ellas (ver src/DevContentEngine.Worker/Program.cs).
Hangfire__DashboardUsername=
Hangfire__DashboardPassword=
